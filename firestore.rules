rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public test document for connection check
    match /test/connection {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allows web client demo/admin operations & seeding
    }

    // Customer orders & PDV transactions
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // General store configuration & social links
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
